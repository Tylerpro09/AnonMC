{
  "schemaVersion": 1,
  "id": "anonmc",
  "version": "${version}",
  "name": "AnonMC",
  "description": "Anonimiza identidades visibles y permite aliases compartidos gestionados por servidor.",
  "authors": ["Tylerpro09"],
  "contact": {
    "sources": "https://github.com/Tylerpro09/AnonMC"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.tylerpro09.anonmc.AnonMc"],
    "client": ["io.github.tylerpro09.anonmc.client.AnonMcClient"]
  },
  "mixins": [
    {
      "config": "anonmc.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
